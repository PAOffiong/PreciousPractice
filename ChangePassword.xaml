<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.ChangePassword"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
             Title="ChangePassword">
    <Grid
        RowDefinitions="auto,*"
        Padding="20">
        <Grid
            Grid.Row="0"
            RowDefinitions="auto,auto,auto,auto"
            RowSpacing="25">
            <Grid
                ColumnDefinitions="auto,*"
                Grid.Row="0">
                <Image 
                    Grid.Column="0"
                    Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                    HorizontalOptions="Start" 
                    VerticalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label
                     Grid.Column="1"
                     Text="Change Password"
                     FontSize="20"
                     FontFamily="MartelSansBold"
                     HorizontalOptions="Center"
                     TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
            </Grid>
            <VerticalStackLayout
                Grid.Row="1">
                <Label
                    Text="Current Password"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontSize="14"
                    FontFamily="MartelSansRegular"/>
                <Border
                    Stroke="#336699"
                    StrokeShape="RoundRectangle 30"
                    Padding="10,0">
                    <Grid
                        ColumnDefinitions="*,auto">
                        <Entry
                            x:Name="OldPassword"
                            Grid.Column="0"
                            Placeholder="Enter Old Password"
                            PlaceholderColor="#878787"
                            IsPassword="True"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            Keyboard="Numeric"
                            MaxLength="6"
                            FontFamily="MartelSansRegular"
                            FontSize="14"
                            TextChanged="OnPasswordTextChanged"/>
                        <Image
                            Grid.Column="1"
                            Source="{AppThemeBinding Dark=closed_eye, Light=dark_closed_eye}"
                            HorizontalOptions="End">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                                            Tapped="OnEyeIconTapped"
                                            CommandParameter="{x:Reference OldPassword}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="2">
                <Label
                    Text="New Password"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontSize="14"
                    FontFamily="MartelSansRegular"/>
                <Border
                    Stroke="#336699"
                    StrokeShape="RoundRectangle 30"
                    Padding="10,0">
                    <Grid
                        ColumnDefinitions="*,auto">
                        <Entry
                            x:Name="NewPassword"
                            Grid.Column="0"
                            Placeholder="Enter New Password"
                            PlaceholderColor="#878787"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            Keyboard="Numeric"
                            MaxLength="6"
                            IsPassword="True"
                            FontFamily="MartelSansRegular"
                            FontSize="14"
                            TextChanged="OnPasswordTextChanged"/>
                        <Image
                            Grid.Column="1"
                            Source="{AppThemeBinding Dark=closed_eye, Light=dark_closed_eye}"
                            HorizontalOptions="End">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEyeIconTapped"
                                                      CommandParameter="{x:Reference NewPassword}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="3">
                <Label
                    Text="Confirm Password"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontSize="14"
                    FontFamily="MartelSansRegular"/>
                <Border
                    Stroke="#336699"
                    StrokeShape="RoundRectangle 30"
                    Padding="10,0">
                    <Grid
                        ColumnDefinitions="*,auto">
                        <Entry
                            x:Name="ConfirmPassword"
                            Grid.Column="0"
                            Placeholder="Confirm New Password"
                            PlaceholderColor="#878787"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            Keyboard="Numeric"
                            IsPassword="True"
                            MaxLength="6"
                            FontFamily="MartelSansRegular"
                            FontSize="14"
                            TextChanged="OnPasswordTextChanged"/>
                        <Image
                            Grid.Column="1"
                            Source="{AppThemeBinding Dark=closed_eye, Light=dark_closed_eye}"
                            HorizontalOptions="End">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEyeIconTapped"
                                                      CommandParameter="{x:Reference NewPassword}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
                <Label
                    x:Name="PasswordErrorLabel"
                    Text=""
                    TextColor="#9E0404"
                    FontSize="11"
                    FontFamily="MartelSansRegular"
                    Margin="10,5,0,0"
                    IsVisible="False"/>
            </VerticalStackLayout>
        </Grid>
        <Border
            x:Name="ConfirmBorder"
            Grid.Row="1"
            IsEnabled="False"
            Style="{StaticResource ButtonOne}"
            HeightRequest="45"
            Margin="20,0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnConfirmBorderTapped"/>
            </Border.GestureRecognizers>
            <Grid>
                <Label
                    x:Name="ConfirmTxt"
                    TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                    Text="Confirm Password"
                    HorizontalOptions="Center"
                    FontFamily="MartelSansBold"
                    FontSize="12"/>
                <ActivityIndicator
                    x:Name="ConfirmIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    Color="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"/>
            </Grid>
        </Border>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>