<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PreciousPractice.CustomerService"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
             Title="CustomerService">
    <Grid 
        RowDefinitions="auto,auto,auto,auto"
        Padding="20"
        RowSpacing="20">
        <Grid Grid.Row="0"
              ColumnDefinitions="auto,*">
            <Image 
                Grid.Column="0"
                Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                HorizontalOptions="Start" 
                VerticalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackIconTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label
                Grid.Column="1"
                Text="Customer Service Center"
                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                HorizontalOptions="Center"
                FontSize="16"
                FontFamily="MartelSansBold"/>
        </Grid>
        <VerticalStackLayout
            Grid.Row="1">
            <Label
               Text="Chat"
                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                HorizontalOptions="Start"
                FontSize="14"
                FontFamily="MartelSansBold"/>
            <Border
                Stroke="Transparent"
                StrokeShape="RoundRectangle 15"
                BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EAEFF5}"
                Padding="10,15">
                <Border.Shadow>
                    <Shadow 
                        Brush="{AppThemeBinding Dark=#666666, Light=#80000000}"
                        Offset="0,4"
                        Radius="6"
                        Opacity="0.20"/>
                </Border.Shadow>
                <VerticalStackLayout>
                    <Border
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Dark=black, Light=white}"
                        Padding="5"
                        HorizontalOptions="Start"
                        WidthRequest="150">
                        <Label
                            Text="Avg.Response time:1 min"
                            FontSize="10"
                            FontFamily="MartelSansSemiBold"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                    </Border>
                    <Grid
                        ColumnDefinitions="auto,*"
                        ColumnSpacing="5"
                        Margin="0,10,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWhatsAppTapped"/>
                        </Grid.GestureRecognizers>
                        <Image
                            Grid.Column="0"
                            Source="light_whatsapp.png"
                            WidthRequest="25"
                            HeightRequest="25"/>
                        <Label
                            Grid.Column="1"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Whatsapp &#10;"
                                          FontSize="14"
                                          LineHeight="0.6"
                                          FontFamily="MartelSansSemiBold"/>
                                    <Span Text="Start a conversation on whatsapp"
                                          FontSize="12"
                                          FontFamily="MartelSansRegular"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        
        <VerticalStackLayout
            Grid.Row="2">
            <Label
               Text="Call"
                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                HorizontalOptions="Start"
                FontSize="14"
                FontFamily="MartelSansBold"/>
            <Border
                Stroke="Transparent"
                StrokeShape="RoundRectangle 15"
                BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EAEFF5}"
                Padding="10,15">
                <Border.Shadow>
                    <Shadow 
                        Brush="{AppThemeBinding Dark=#666666, Light=#80000000}"
                        Offset="0,4"
                        Radius="6"
                        Opacity="0.20"/>
                </Border.Shadow>
                <VerticalStackLayout>
                    <Border
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Dark=black, Light=white}"
                        Padding="5"
                        HorizontalOptions="Start"
                        WidthRequest="150">
                        <Label
                            Text="Avg.Response time:2 min"
                            FontSize="10"
                            FontFamily="MartelSansSemiBold"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                    </Border>
                    <Grid
                        ColumnDefinitions="*,auto"
                        ColumnSpacing="5"
                        Margin="0,10,0,0">
                        <Label
                            Grid.Column="0"
                            Text="+234 813 054 5390"
                            FontSize="12"
                            FontFamily="MartelSansRegular"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                        <Border
                            Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 15"
                            BackgroundColor="{AppThemeBinding Dark=black, Light=white}"
                            Padding="5"
                            HorizontalOptions="End">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout>
                                <Image
                                    Source="green_call_icon.png"
                                    WidthRequest="10"
                                    HeightRequest="10"
                                    Margin="0,0,5,0"/>
                                <Label
                                    Text="Call"
                                    FontSize="10"
                                    FontFamily="MartelSansSemiBold"
                                    TextColor="#009933"
                                    VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <VerticalStackLayout
            Grid.Row="3">
            <Label
               Text="Email"
                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                HorizontalOptions="Start"
                FontSize="14"
                FontFamily="MartelSansBold"/>
            <Border
                Stroke="Transparent"
                StrokeShape="RoundRectangle 15"
                BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EAEFF5}"
                Padding="10,15">
                <Border.Shadow>
                    <Shadow 
                        Brush="{AppThemeBinding Dark=#666666, Light=#80000000}"
                        Offset="0,4"
                        Radius="6"
                        Opacity="0.20"/>
                </Border.Shadow>
                <VerticalStackLayout>
                    <Border
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Dark=black, Light=white}"
                        Padding="5"
                        HorizontalOptions="Start"
                        WidthRequest="150">
                        <Label
                            Text="Avg.Response time:12hrs"
                            FontSize="10"
                            FontFamily="MartelSansSemiBold"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                    </Border>
                    <Grid
                        ColumnDefinitions="*,auto"
                        ColumnSpacing="5"
                        Margin="0,10,0,0">
                        <Label                            
                            Grid.Column="0"
                            Text="customercare@pyrowoonline.com"
                            FontSize="12"
                            FontFamily="MartelSansRegular"
                            LineBreakMode="TailTruncation"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                        <Border
                            Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{AppThemeBinding Dark=black, Light=white}"
                            Padding="5"
                            HorizontalOptions="End">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEmailTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout>
                                <Image
                                    Source="light_mail.png"
                                    WidthRequest="15"
                                    HeightRequest="15"
                                    Margin="0,0,5,0"/>
                                <Label
                                    Text="Email"
                                    FontSize="10"
                                    FontFamily="MartelSansSemiBold"
                                    TextColor="#009933"
                                    VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>