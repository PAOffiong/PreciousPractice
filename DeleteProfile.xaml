<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.DeleteProfile"
             
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
             Title="DeleteProfile">
    <Grid 
        RowDefinitions="*,auto">
        <Grid
            Padding="20"
            Grid.Row="0"
            RowSpacing="10"
            RowDefinitions="auto,auto,auto,auto">
            <VerticalStackLayout
                Grid.Row="0">
                <Image
                    Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                    HorizontalOptions="Start" 
                    VerticalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label
                    Text="Delete Profile"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    HorizontalOptions="Center"
                    FontFamily="MartelSansExtraBold"
                    FontSize="20"/>
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="1">
                <Image
                    Source="blocked_user_profile.png"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="99"
                    HeightRequest="99"/>
                <Label
                    Text="Are you sure you want to delete this profile?"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    HorizontalTextAlignment="Center"
                    FontFamily="MartelSansBold"
                    FontSize="14"
                    Margin="0,30,0,0"/>
            </VerticalStackLayout>
            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EBF0F5}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 15">
                <Grid
                    RowDefinitions="auto,auto,auto,auto"
                    RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Text="Please Note:"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalTextAlignment="Start"
                        FontFamily="MartelSansBold"
                        FontSize="16" />
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions=" auto, *"
                        ColumnSpacing="7">
                        <Image
                            Grid.Column="0"
                            Source="red_warning.png"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="24"
                            HeightRequest="24"/>
                        <Label
                            Grid.Column="1"
                            Text="You can delete your profile and your bank account if you do not have any transaction history with the bank."
                            HorizontalTextAlignment="Justify"
                            FontSize="10"
                            FontFamily="MartelSansRegular"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                    </Grid>
                    <Grid
                        Grid.Row="2"
                        ColumnDefinitions=" auto, *"
                        ColumnSpacing="7">
                        <Image
                            Grid.Column="0"
                            Source="red_warning.png"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="24"
                            HeightRequest="24"/>
                        <Label
                            Grid.Column="1"
                            Text=" Deleting your mobile profile does not delete your bank account if you have existing transaction history with the bank."
                            HorizontalTextAlignment="Justify"
                            FontSize="10"
                            FontFamily="MartelSansRegular"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                    </Grid>
                    <Grid
                        Grid.Row="3"
                        ColumnDefinitions=" auto, *"
                        ColumnSpacing="7">
                        <Image
                            Grid.Column="0"
                            Source="red_warning.png"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="24"
                            HeightRequest="24"/>
                        <Label
                            Grid.Column="1"
                            Text="You can create another profile anytime you want to start using the mobile app and link it to the existing account you have with the bank."
                            HorizontalTextAlignment="Justify"
                            FontSize="10"
                            FontFamily="MartelSansRegular"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border
            Grid.Row="1" IsEnabled="True"
            Style="{StaticResource ButtonOne}"
            HeightRequest="40"
            Margin="20">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDeleteProfileBorderTapped"/>
            </Border.GestureRecognizers>
            <Grid>
                <Label
                    x:Name="DeleteProfileTxt"
                    Text="Delete Profile"
                    TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    FontFamily="MartelSansBold"
                    FontSize="12"/>
                <ActivityIndicator
                    x:Name="DeleteProfileIndicator"
                    Color="{AppThemeBinding Dark=#141414,Light=#FFFFFF}"
                    IsVisible="False"
                    IsRunning="False"
                    WidthRequest="18"
                    HeightRequest="18"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>
            </Grid>
        </Border>
        <Grid
            x:Name="PopupOverlay"
            Grid.RowSpan="2"
            IsVisible="False"
            Padding="0,30,0,0"
            BackgroundColor="#4D000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPopupOverlayTapped"/>
            </Grid.GestureRecognizers>
            <Border
                x:Name="PopupCard"
                BackgroundColor="{AppThemeBinding  Dark=#141414, Light=#FFFFFF}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                Padding="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupCardTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    Spacing="10">
                    <Label
                        Text="Confirm Deletion"
                        HorizontalOptions="Center"
                        TextColor="#009933"
                        FontFamily="MartelSansBold"
                        FontSize="16"/>
                    <Label
                        Text="Enter your passsword to proceed."
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="Center"
                        FontFamily="MartelSansRegular"
                        FontSize="14"/>
                    <Border
                        Stroke="#009933"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 30">
                        <Entry
                            Margin="15,0,0,0" 
                            x:Name="PasswordEntry"
                            IsPassword="True"
                            MaxLength="6"
                            Placeholder="Enter your password"
                            PlaceholderColor="#878787"
                            VerticalOptions="Center"
                            FontSize="12"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            Keyboard="Numeric"
                            TextChanged="OnPassWordTextChanged"/>
                    </Border>
                    <Label
                        x:Name="PasswordErrorLabel"
                        Text="Incorrect password. Please try again."
                        TextColor="#9E0404"
                        FontSize="10"
                        FontFamily="MartelSansRegular"
                        HorizontalOptions="Center"
                        IsVisible="False"/>
                    <Grid
                        Margin="0,10,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">
                        <Border
                            Grid.Column="0"
                            Stroke="#336699"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 30"
                            HeightRequest="35"
                            WidthRequest="130">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelBorderTapped"/>
                            </Border.GestureRecognizers>
                            <Label
                                Text="Cancel"
                                TextColor="#336699"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                FontFamily="MartelSansBold"
                                FontSize="12"/>
                        </Border>
                        <Border
                            x:Name="ConfirmBorder"
                            Grid.Column="1"
                            Style="{StaticResource ButtonOne}"
                            HeightRequest="40"
                            WidthRequest="130"
                            Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirmBorderTapped"/>
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label
                                    x:Name="ConfirmTxt"
                                    Text="Confirm"
                                    TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    FontFamily="MartelSansBold"
                                    FontSize="12"/>
                                <ActivityIndicator
                                    x:Name="ConfirmIndicator"
                                    Color="{AppThemeBinding Dark=#141414,Light=#FFFFFF}"
                                    IsVisible="False"
                                    IsRunning="False"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"/>
                                </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>