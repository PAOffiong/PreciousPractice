<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="PreciousPractice.LegalandCompliance"
            xmlns:local="clr-namespace:PreciousPractice"
            Shell.NavBarIsVisible="False"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}"
            Title="LegalandCompliance">
    <Grid 
        RowDefinitions="Auto,*">
        <ScrollView 
            Grid.Row="0">
            <VerticalStackLayout
                Padding="20"
                Spacing="2">
                <Image
                    Source="{AppThemeBinding
                        Light=vector_left_black.png,
                        Dark=vector_left_white.png}"
                    HorizontalOptions="Start"
                    Margin="5,5,5,10">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label
                    Text="Legal and Compliance"
                    FontFamily="MartelSansExtraBold"
                    FontSize="20"
                    Margin="5"
                    FontAttributes="Bold" />
                <Label
                    Text="Transparency and Verification details"
                    FontFamily="MartelSansRegular"
                    FontSize="16"
                    Margin="5,0,5,5" />
                <Border
                    Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#171C21}"
                        Padding="0">
                        <BoxView
                            WidthRequest="4"
                            BackgroundColor="#2E8B57"
                            HorizontalOptions="Start" />
                        <Label                         
                            FontSize="12"
                            LineHeight="1.3"
                            Padding="12,10">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        Text="This platform is operated by " />
                                    <Span
                                        Text="Appsolut Focus (Ibeju-Lekki) Cooperative Multipurpose Society Limited"
                                        FontAttributes="Bold" />
                                    <Span
                                        Text=", a cooperative society duly registered under the Cooperative Societies Law of Lagos State, Nigeria." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>
                <Border
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#171C21}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    Padding="15"
                    StrokeShape="RoundRectangle 10">
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Offset="0,4"
                            Radius="15"
                            Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout
                        Spacing="0">
                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        Text="ORGANIZATION DETAILS"
                                        FontFamily="MartelSansBold"
                                        FontSize="14"
                                        FontAttributes="Bold" />
                                    <Span Text="&#10;" />
                                    <Span
                                        Text="Organization Name"
                                        FontSize="12"
                                        FontFamily="MartelSansRegular" />
                                    <Span Text="&#10;" />
                                    <Span
                                        Text="Appsolut Focus(Ibeju-Lekki) Cooperative Multipurpose Society Limited"
                                        FontFamily="MartelSansBold"
                                        FontAttributes="Bold"
                                        FontSize="14" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#393938}"
                            HorizontalOptions="Fill" />
                        <Label
                            Padding="10">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        Text="Registration Number"
                                        FontFamily="MartelSansRegular"
                                        FontSize="12" />
                                    <Span Text="&#10;" />
                                    <Span
                                        Text="LSCS 17690"
                                        FontFamily="MartelSansBold"
                                        FontAttributes="Bold"
                                        FontSize="14" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#393938}"
                            HorizontalOptions="Fill" />
                        <Label
                            Padding="5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        Text="Issuing Authority"
                                        FontFamily="MartelSansRegular"
                                        FontSize="12" />
                                    <Span Text="&#10;" />
                                    <Span
                                        Text="Lagos State Ministry of Commerce, Industry &amp; Cooperatives"
                                        FontFamily="MartelSansBold"
                                        FontSize="14"
                                        FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#393938}"
                            HorizontalOptions="Fill" />
                        <Label
                            Padding="5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        Text="Date Registered"
                                        FontFamily="MartelSansRegular"
                                        FontSize="12" />
                                    <Span Text="&#10;" />
                                    <Span
                                        Text="9 June 2021"
                                        FontAttributes="Bold"
                                        FontFamily="MartelSansBold"
                                        FontSize="14" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#393938}"
                            HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">
            <Border
                Style="{StaticResource ButtonOne}"
                Margin="0,10,0,0"
                WidthRequest="320">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="NavToRegistrationCertificate" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">
                    <Label
                        Text="View Registration Certificate"
                        TextColor="{AppThemeBinding Light=White, Dark=#121212}"
                        FontFamily="MartelSansBold"
                        FontSize="14"
                        VerticalOptions="Center" />
                    <Image
                        x:Name="RegistrationArrow"
                        Source="{AppThemeBinding Light=arrow_white.png, Dark=arrow_black.png}"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center" />
                    <ActivityIndicator
                        x:Name="RegistrationIndicator"
                        Color="{AppThemeBinding Light=white,Dark=black}"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center"
                        IsVisible="False"
                        IsRunning="False" />
                </HorizontalStackLayout>
            </Border>
            <Border
                StrokeShape="RoundRectangle 30"
                StrokeThickness="1"
                Stroke="#336699"
                WidthRequest="320"
                HeightRequest="45"
                Margin="15,5,15,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="NavToIdInformation" />
                </Border.GestureRecognizers>
                <Grid>
                    <Label
                         Text="Continue to Sign Up" IsVisible="True" x:Name="SignupTxt"
                         Style="{StaticResource labelButton}"
                         FontFamily="MartelSansBold"
                         FontAttributes="Bold"
                         FontSize="14"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         TextColor="#336699"
                         VerticalTextAlignment="Center" />
                    <ActivityIndicator 
                        Color="Blue"
                        WidthRequest="20"
                        HeightRequest="20"
                        x:Name="indicator"
                        IsRunning="False"
                        IsVisible="False"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Grid>
            </Border>
            <HorizontalStackLayout
                Margin="0,5,0,10"
                HorizontalOptions="Center"
                Spacing="5">
                <Image
                    Source="check_small.png"
                    WidthRequest="18"
                    HeightRequest="18" />

                <Label
                    Text="Lagos State Registered Cooperative"
                    FontSize="12"
                    FontFamily="MartelSansRegular"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <local:LoadingOverlay
        x:Name="Loading"
        Grid.RowSpan="2"/>
    </Grid>
</ContentPage>