<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.MembershipStatus"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
             Title="MembershipStatus">
    <Grid      
        RowDefinitions="*,auto">
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20"
            Spacing="20">
            <Grid
                ColumnDefinitions="auto,*"
                ColumnSpacing="10"
                Margin="0,20,0,0">
                <Image
                    Grid.Column="0"
                    Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                    VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped"/>
                    </Image.GestureRecognizers>
                </Image>
                <Label
                    Grid.Column="1"
                    Text="Membership Status - Pending"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontSize="20"
                    FontFamily="MartelSansSemiBold"
                    VerticalOptions="Center"/>
            </Grid>
            <Border
                Stroke="#009933"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="#90EE90"
                Padding="15,20">
                <VerticalStackLayout Spacing="7">
                    <Image
                        Source="hourglass_img.png"
                        WidthRequest="40"
                        HeightRequest="40"/>
                    <Label
                        Text="Verification Submitted"
                        TextColor="#141414"
                        FontFamily="MartelSansSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="Your NIN/BVN has been successfully received."
                        TextColor="#141414"
                        FontFamily="MartelSansRegular"
                        FontSize="14"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="Your account is currently under review and will be activated shortly."
                        TextColor="#141414"
                        FontFamily="MartelSansRegular"
                        FontSize="14"
                        HorizontalTextAlignment="Center"/>
                    <Border
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EBF0F5}"
                        Padding="10"
                        Margin="0,10,0,0">
                        <Border.Shadow>
                            <Shadow
                                Brush="{AppThemeBinding Dark=#666666, Light=#80000000}"
                                Offset="0,4"
                                Opacity="0.3"
                                Radius="10"/>
                        </Border.Shadow>
                        <VerticalStackLayout
                            Spacing="5"
                            HorizontalOptions="Center">
                            <Label
                                Text="Current Status"
                                TextColor="#878787"
                                FontSize="14"
                                FontFamily="MartelSansRegular"
                                HorizontalTextAlignment="Center"/>
                            <Label
                                Text="VERIFICATION IN PROGRESS"
                                TextColor="#009933"
                                FontSize="16"
                                FontFamily="MartelSansSemiBold"
                                HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <Border
            x:Name="BackToHomeBorder"
            Grid.Row="1"
            Style="{StaticResource ButtonOne}"
            HeightRequest="45"
            Margin="20,40">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackToHomeTapped"/>
            </Border.GestureRecognizers>
            <Grid>
                <Label
                    x:Name="BackToHomeTxt"
                    Text="Back to Home"
                    TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                    FontFamily="MartelSansSemiBold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                <ActivityIndicator
                    x:Name="BackToHomeIndicator"
                    Color="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                    IsRunning="False"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="18"
                    HeightRequest="18"/>
            </Grid>
        </Border>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>
