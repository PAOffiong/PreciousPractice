<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             Shell.NavBarIsVisible="False"
             x:Class="PreciousPractice.MorePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
             Title="MorePage">
    <Grid 
        RowDefinitions="*,auto">
        <Image
            Source="{AppThemeBinding Light=create_background.png, Dark=dark_background.png}"
            Grid.RowSpan="2" 
            Aspect="AspectFill"/>
        <Grid
            RowDefinitions="auto,4*,auto,3*"
            Padding="20">
            <!--background-->
            <Border
                Margin="0,25,0,0"
                Grid.Row="0"
                Stroke="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                StrokeShape="RoundRectangle 50"
                StrokeThickness="1"
                Padding="10">
                <Grid
                    ColumnDefinitions="auto,*, auto">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="#1A336699"
                        Stroke="#336699"
                        StrokeShape="RoundRectangle 90"
                        WidthRequest="50"
                        HeightRequest="50">
                        <Image
                            Source="flower_green.png"
                            WidthRequest="30"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1">
                        <Label
                            x:Name="UserName"
                            Text="Hi, "
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            FontFamily="MartelSansSemiBold"
                            FontSize="16"
                            Margin="5,0,0,0"/>
                        <HorizontalStackLayout>
                            <Image
                                Source="coin_icon.png"/>
                            <Label
                                Text="Tier 1"
                                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                                FontSize="12"
                                FontFamily="MartelSansRegular"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Image
                        x:Name="Settings"
                        Grid.Column="2"
                        Source="settings.png"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>
            <!--Body part of the background-->
            <VerticalStackLayout
                    Grid.Row="2"
                    Spacing="15">
                <Grid
                        ColumnDefinitions="auto,*,auto"
                        Margin="0,0,0,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTransactionHistoryTapped"/>
                    </Grid.GestureRecognizers>
                    <Image
                            Grid.Column="0"
                            Source="transaction_receipts.png"
                            WidthRequest="24"
                            HeightRequest="24"/>
                    <Label
                            Grid.Column="1"
                            Text="Transaction History"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            FontSize="14"
                            Margin="5,0,0,0"
                            FontFamily="MartelSansRegular"/>
                    <Image
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="{AppThemeBinding Dark=right_vector_white, Light=right_vector_black}"/>
                </Grid>
                <Grid
                        ColumnDefinitions="auto,*,auto"
                        Margin="0,0,0,20">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBVNTapped"/>
                    </Grid.GestureRecognizers>
                    <Image
                            Grid.Column="0"
                            Source="phone_icon.png"
                            VerticalOptions="Start"
                            WidthRequest="24"
                            HeightRequest="24"/>
                    <VerticalStackLayout
                            Grid.Column="1">
                        <Label
                                Text="Complete Verification"
                                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                                FontSize="14"
                                Margin="5,0,0,0"
                                FontFamily="MartelSansRegular"/>
                        <Label
                                Text="NIN/BVN"
                                TextColor="#009933"
                                FontSize="16"
                                FontFamily="MartelSansRegular"/>
                    </VerticalStackLayout>
                    <Image
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="{AppThemeBinding Dark=right_vector_white, Light=right_vector_black}"/>
                </Grid>
                <BoxView
                        HeightRequest="1"
                        Color="{AppThemeBinding Dark=#FFFFFF,Light=#141414}"/>
                <Grid
                        ColumnDefinitions="auto,*,auto"
                        ColumnSpacing="5">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCustomerServiceTapped"/>
                    </Grid.GestureRecognizers>
                    <Image
                            Grid.Column="0"
                            Source="customer_service.png"
                            WidthRequest="24"
                            HeightRequest="24"/>
                    <Label
                            Grid.Column="1"
                            Text="Customer Service Contact"
                            FontSize="14"
                            FontFamily="MartelSansRegular"/>
                    <Image
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="{AppThemeBinding Dark=right_vector_white, Light=right_vector_black}"/>
                </Grid>
                <Grid
                        ColumnDefinitions="auto,*,auto"
                        ColumnSpacing="5">
                    <Image
                            Grid.Column="0"
                            Source="customer_service.png"
                            WidthRequest="24"
                            HeightRequest="24"/>
                    <Label
                            Grid.Column="1"                     
                            FontFamily="MartelSansRegular">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Pyrowo USSD(*7006*19*28#) &#10;"
                                     FontSize="16"/>
                                <Span Text =" Open account, send money, &#10; buy airtime, pay bills via USSD"
                                    FontSize="14"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Image
                            x:Name="UssdToggle"
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="light_add_beneficiaries.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleImageTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Grid
                        ColumnDefinitions="auto,*,auto"
                        ColumnSpacing="5">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnThemeTapped"/>
                    </Grid.GestureRecognizers>
                    <Image
                            Grid.Column="0"
                            Source="theme_icon.png"
                            WidthRequest="24"
                            HeightRequest="24"/>
                    <Label
                            Grid.Column="1"
                            Text="Themes"
                            FontSize="14"
                            FontFamily="MartelSansRegular"/>
                    <Image
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="{AppThemeBinding Dark=right_vector_white, Light=right_vector_black}"/>
                </Grid>
                <Grid
                        ColumnDefinitions="auto,*,auto"
                        ColumnSpacing="5">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutTapped"/>
                    </Grid.GestureRecognizers>
                    <Image
                            Grid.Column="0"
                            Source="transaction_receipts.png"
                            WidthRequest="24"
                            HeightRequest="24"/>
                    <Label
                            Grid.Column="1"
                            Text="About"
                            FontSize="14"
                            FontFamily="MartelSansRegular"/>
                    <Image
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="{AppThemeBinding Dark=right_vector_white, Light=right_vector_black}"/>
                </Grid>
            </VerticalStackLayout>
        </Grid>
        <!--Bottom Navigation Bar-->
        <local:BottomStaticBorder ActiveTab="More"
            Grid.Row="1"/>
        <!--USSD popup-->
        <Grid
            Grid.RowSpan="2"
            x:Name="UssdPopupOverlay"
            BackgroundColor="{AppThemeBinding Light=#1A000000, Dark=#4D000000}"
            IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUssdPopupOverlayTapped"/>
            </Grid.GestureRecognizers>
            <Border
                 Padding="20"
                 x:Name="UssdPopupCard"
                 Stroke="#009933"
                 StrokeShape="RoundRectangle 20,20,0,0"
                 BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#141414}"
                 VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUssdPopupCardTapped"/>
                </Border.GestureRecognizers>
                <Grid
                    RowDefinitions="auto,auto,auto,auto,auto"
                    RowSpacing="10">
                    <Border
                        Grid.Row="0"
                        Stroke="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        StrokeShape="Ellipse"
                        WidthRequest="15"
                        HeightRequest="15"
                        HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearTapped"/>
                        </Border.GestureRecognizers>
                        <Label
                            Text="x"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            HorizontalOptions="Center"
                            FontSize="12"/>
                    </Border>
                    <VerticalStackLayout
                        Grid.Row="1">
                        <Label
                            Text="Set USSD PIN"
                            TextColor="#009933"
                            FontSize="16"
                            FontFamily="MartelSansSemiBold"/>
                        <Label
                            Text="The PIN must contain number which cannot be repeated or consecutive."
                            HorizontalTextAlignment="Justify"
                            FontSize="10"
                            FontFamily="MartelSansRegular"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout
                        Grid.Row="2">
                        <Label
                            Text="Choosen PIN"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            FontSize="16"
                            FontFamily="MartelSansRegular"/>
                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            ColumnSpacing="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            Margin="20,10,0,0">
                            <Grid 
                                Grid.Column="0"
                                HeightRequest="50"
                                WidthRequest="50"
                                Padding="0">
                                <Image
                                   Source="blue_ellipse.png"/>
                                <Entry 
                                    x:Name="Code1"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"
                                    Margin="0"/>
                            </Grid>
                            <Grid 
                                Grid.Column="1"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0">
                                <Image 
                                    Source="blue_ellipse.png"/>
                                <Entry 
                                    x:Name="Code2"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                            <Grid
                                Grid.Column="2"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0">
                                <Image 
                                    Source="blue_ellipse.png"/>
                                <Entry
                                    x:Name="Code3"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                            <Grid 
                                Grid.Column="3"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0">
                                <Image 
                                    Source="blue_ellipse.png"/>
                                <Entry 
                                    x:Name="Code4"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout
                        Grid.Row="3">
                        <Label
                            Text="Confirm PIN"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            FontSize="16"
                            FontFamily="MartelSansRegular"/>
                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            ColumnSpacing="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            Margin="20,10,0,20">
                            <Grid 
                                Grid.Column="0"
                                HeightRequest="50"
                                WidthRequest="50"
                                Padding="0">
                                <Image
                                   Source="blue_ellipse.png"/>
                                <Entry 
                                    x:Name="Code5"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"
                                    Margin="0"/>
                            </Grid>
                            <Grid 
                                Grid.Column="1"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0">
                                <Image 
                                    Source="blue_ellipse.png"/>
                                <Entry 
                                    x:Name="Code6"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                            <Grid
                                Grid.Column="2"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0">
                                <Image 
                                    Source="blue_ellipse.png"/>
                                <Entry
                                    x:Name="Code7"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                            <Grid 
                                Grid.Column="3"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0">
                                <Image 
                                    Source="blue_ellipse.png"/>
                                <Entry 
                                    x:Name="Code8"
                                    Keyboard="Numeric"
                                    IsPassword="True"
                                    MaxLength="1"
                                    TextChanged="OnCodeTextChanged"
                                    Focused="OnCodeFocused"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    BackgroundColor="Transparent"/>
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                    <Border
                        x:Name="ProceedBorder"
                        Grid.Row="4"
                        Style="{StaticResource ButtonOne}" 
                        Margin="20,0"
                        HeightRequest="45" 
                        IsEnabled="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProceedBorderTapped"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label
                                x:Name="ProceedTxt"
                                Text="Proceed"
                                TextColor="{AppThemeBinding Light=white, Dark=Black}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                FontSize="12"
                                FontFamily="MartelSansBold"
                                FontAttributes="Bold"/>
                            <ActivityIndicator
                                x:Name="ProceedIndicator"
                                Color="{AppThemeBinding Light=white, Dark=Black}"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center"
                                IsVisible="False"
                                IsRunning="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>