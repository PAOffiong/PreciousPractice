<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.PINManagement"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
             Title="PINManagement">
    <Grid
        RowSpacing="20"
        RowDefinitions="auto,auto">
        <Grid
            Padding="20"
            ColumnDefinitions="auto,*"
            Grid.Row="0">
            <Image 
                Grid.Column="0"
                Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                HorizontalOptions="Start" 
                VerticalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackIconTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label
                Margin="0,10,0,0"
                Grid.Column="1"
                Text="Pyrowo PIN Management"
                FontSize="20"
                FontFamily="MartelSansBold"
                HorizontalOptions="Center"
                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
        </Grid>
        <Border
            Grid.Row="1"
            Stroke="Transparent"
            StrokeShape=" RoundRectangle 15"
            BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EAEFF5}"
            Padding="10,5">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCreatePinTapped"/>
            </Border.GestureRecognizers>
            <Border.Shadow>
                <Shadow 
                    Brush="{AppThemeBinding Dark=#666666, Light=#800000000}"
                    Offset="0,4"
                    Radius="6"
                    Opacity="0.20"/>
            </Border.Shadow>
            <VerticalStackLayout>
                <Label
                    Text="Create PIN"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontSize="14"
                    FontFamily="MartelSansRegular"/>
                <Label
                    Text="Get a new Pyrowo PIN"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontSize="14"
                    FontFamily="MartelSansRegular"/>
            </VerticalStackLayout>
        </Border>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>