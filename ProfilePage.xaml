<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             Shell.NavBarIsVisible="False"
             x:Class="PreciousPractice.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Dark=Black, Light=White}"
             Title="ProfilePage">
    <Grid 
        RowDefinitions="*,Auto">
        <Grid
            Grid.Row="0"
            RowDefinitions="auto,auto,auto,auto,*"
            RowSpacing="5"
             Padding="20">
            <VerticalStackLayout
                Grid.Row="0">
                <Image
                    Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                    HorizontalOptions="Start" 
                    VerticalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped"/>
                    </Image.GestureRecognizers>
                </Image>
                <Label
                    Text="My Profile"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    HorizontalOptions="Center"
                    FontFamily="MartelSansExtraBold"
                    FontSize="20"/>
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,20,0,10">
                <!-- Picture with a camera icon on its bottom-right corner -->
                <Grid
                    WidthRequest="80"
                    HeightRequest="80"
                    HorizontalOptions="Center">
                    <Border
                        StrokeShape="Ellipse"
                        Stroke="Transparent"
                        WidthRequest="80"
                        HeightRequest="80">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCameraIconTapped"/>
                        </Border.GestureRecognizers>
                        <Image
                            x:Name="ProfileImage"
                            Source="{AppThemeBinding Dark=profile_picture, Light=light_profile_picture}"
                            Aspect="AspectFill"/>
                    </Border>
                    <Image
                        x:Name="CameraIcon"
                        Source="{AppThemeBinding Dark=profile_picture, Light=light_profile_picture}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="70"
                        HeightRequest="70">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCameraIconTapped"/>
                    </Image.GestureRecognizers>
                </Image>
                </Grid>
                <Label
                    x:Name="ProfileNameUnderPicture"
                    Text=""
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                    FontFamily="MartelSansRegular"
                    FontSize="14"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="2"
                Spacing="7">
                <Grid
                    ColumnDefinitions="auto,*">
                    <Label
                        Grid.Column="0"
                        Text="Full Name"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="Start"
                        FontFamily="MartelSansLight"
                        FontSize="14"/>
                    <Label
                        x:Name="ProfileName"
                        Grid.Column="1"
                        Text=""
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="End"
                        FontFamily="MartelSansRegular"
                        FontSize="14"/>
                </Grid>
                <Grid
                    ColumnDefinitions="auto,*">
                    <Label
                        Grid.Column="0"
                        Text="Mobile Number"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="Start"
                        FontFamily="MartelSansLight"
                        FontSize="14"/>
                    <HorizontalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="End">
                        <Label
                            x:Name="PhoneNumber"                            
                            Text=" "
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            HorizontalOptions="Center"
                            FontFamily="MartelSansRegular"
                            FontSize="14"/>
                        <Image
                            x:Name="EditIcon"
                            Source="edit_icon.png"
                            WidthRequest="12"
                            HeightRequest="12">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditIconTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </HorizontalStackLayout>
                </Grid>
                <Grid
                    ColumnDefinitions="auto,*, auto">
                    <Label
                        Grid.Column="0"
                        Text="Gender"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="Start"
                        FontFamily="MartelSansLight"
                        FontSize="14"/>
                    <Label
                        x:Name="GenderLabel"
                        Grid.Column="2"
                        Text=" "
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="End"
                        FontFamily="MartelSansRegular"
                        FontSize="14"/>
                </Grid>
                <Grid
                    ColumnDefinitions="auto,*, auto">
                    <Label
                        Grid.Column="0"
                        Text="Date of Birth"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="Start"
                        FontFamily="MartelSansLight"
                        FontSize="14"/>
                    <Label
                        x:Name="DateOfBirthLabel"
                        Grid.Column="2"
                        Text=" "
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="End"
                        FontFamily="MartelSansRegular"
                        FontSize="14"/>
                </Grid>
                <Grid
                    ColumnDefinitions="auto,*">
                    <Label
                        Grid.Column="0"
                        Text="Email"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="Start"
                        FontFamily="MartelSansLight"
                        FontSize="14"/>
                    <Label
                        x:Name="EmailAddressLabel"
                        Grid.Column="1"
                        Text=""
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        HorizontalOptions="End"
                        FontFamily="MartelSansRegular"
                        FontSize="14"/>
                </Grid>
            </VerticalStackLayout>
            <Border
                Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EBF0F5}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 15">
                <Grid
                    RowDefinitions="*,*">
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="auto,*">
                        <Label
                            Grid.Column="0"
                            Text=" Account Number"
                            TextColor="{AppThemeBinding Dark=#FFFFFF,Light=#141414}"
                            FontFamily="MartelSansLight"
                            FontSize="14"
                            HorizontalOptions="Start"/>
                        <HorizontalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="End">
                            <Label
                                x:Name="AccountNumberLabel"
                                Text=""
                                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                                FontSize="14"
                                FontFamily="MartelSansRegular"/>
                            <Image
                                Source="{AppThemeBinding Light=black_copy_icon.png, Dark=white_copy_icon}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCopyAccountNumberTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid 
                        Grid.Row="1"
                        ColumnDefinitions="auto,*">
                        <Label
                            Grid.Column="0"
                            Text="Account Type"
                            TextColor="{AppThemeBinding Dark=#FFFFFF,Light=#141414}"
                            FontFamily="MartelSansLight"
                            FontSize="14"
                            HorizontalOptions="Start"/>
                        <Image
                            Grid.Column="1"
                            Source="one_tier.png"
                            WidthRequest="60"
                            HeightRequest="20"
                            HorizontalOptions="End"/>
                    </Grid>
                </Grid>
            </Border>
            <HorizontalStackLayout
                Grid.Row="4"
                HorizontalOptions="Center">
                <Image
                    Source="delete.png"
                    VerticalOptions="Center"
                    WidthRequest="13.33"
                    HeightRequest="15"/>
                <Label
                    Text="Delete Profile"
                    TextColor="#9E0404"
                    FontSize="14"
                    FontFamily="MartelSansBold"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteProfileTapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>
        </Grid>
        <!--Bottom Navigation Bar-->
        <local:BottomStaticBorder ActiveTab="Profile"
            Grid.Row="1"/>
        <Grid
            x:Name="PopupOverlay"
            Grid.RowSpan="2"
            IsVisible="False"
            Padding="10,0,10,10"
            BackgroundColor="#4D000000">
            <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPopupOverlayTapped"/>
            </Grid.GestureRecognizers>
            <Border
                x:Name="PopupCard"
                BackgroundColor="{AppThemeBinding  Dark=#141414, Light=#FFFFFF}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                Padding="20,10,20,20"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPopupCardTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    Spacing="10">
                    <Image
                        Source="security_warning_icon.png"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="Change Phone Number"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        FontFamily="MartelSansBold"
                        FontSize="20"/>
                    <Label
                        HorizontalTextAlignment="Center"
                        FontFamily="MartelSansRegular"
                        FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="You may update your Phone number if its no longer in use or have lost access to this number"
                                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                                <Span
                                   x:Name="PhoneNumberLabel"
                                   Text=""
                                   TextColor="#009933"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Grid
                        ColumnDefinitions="auto,*">
                        <Image
                            Grid.Column="0"
                            Source="dangerous.png"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"/>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="5,0,0,0">
                            <Label
                                HorizontalTextAlignment="Justify"
                                FontSize="10"
                                FontFamily="MartelSansRegular"
                                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                                Text="Once you have updated your phone number, you will no longer be able to use the previous number to access the account."/>
                            <Label
                                Margin="0,3,0,0"
                                HorizontalTextAlignment="Justify"
                                FontSize="10"
                                TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                                FontFamily="MartelSansRegular"
                                Text="After updating, all acount notifications and alerts will be sent only to your new phone number."/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid
                        ColumnDefinitions="auto,*">
                        <Image
                            Grid.Column="0"
                            Source="amend_icon.png"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"/>
                        <Label
                            Margin="5,0,0,0"
                            Grid.Column="1"
                            HorizontalTextAlignment="Justify"
                            FontSize="10"
                            FontFamily="MartelSansRegular"
                            TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                            Text="If you forget your PIN, recovery code will only be sent to your new phone number."/>
                    </Grid>
                    <Border
                        Stroke="#9E0404"
                        StrokeShape="RoundRectangle 30"
                        BackgroundColor="#DC143C"
                        StrokeThickness="1"
                        Padding="7">
                        <Grid
                            ColumnDefinitions="auto,*">
                            <Image
                                Grid.Column="0"
                                Source="warning_red.png"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="24"
                                HeightRequest="24"/>
                            <Label
                                Grid.Column="1"
                                LineHeight="0.5"
                                Text="Once your account is updated to a new phone number all mobile banking services will immediately use the new number."
                                HorizontalTextAlignment="Justify"
                                FontSize="10"
                                FontFamily="MartelSansRegular"
                                TextColor="#FFFFFF"
                                Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">
                        <Border
                            Grid.Column="0"
                            Stroke="#336699"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 30"
                            HeightRequest="35"
                            WidthRequest="130">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackBorderTapped"/>
                            </Border.GestureRecognizers>
                            <Label
                                Text="Back"
                                TextColor="#336699"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                FontFamily="MartelSansBold"
                                FontSize="12"/>
                        </Border>
                        <Border
                            IsEnabled="True"
                            Grid.Column="1"
                            Style="{StaticResource ButtonOne}"
                            HeightRequest="40"
                            WidthRequest="130"
                            Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProceedBorderTapped"/>
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label
                                    x:Name="ProceedTxt"
                                    Text="Proceed"
                                    TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    FontFamily="MartelSansBold"
                                    FontSize="12"/>
                                <ActivityIndicator
                                    x:Name="ProceedIndicator"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Color="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    IsVisible="False"
                                    IsRunning="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>