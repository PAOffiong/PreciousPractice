<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.RegisterForgotPassword"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=Black, Light=White}"
             Title="RegisterForgotPassword">
    <Grid>
        <Grid Grid.Row="0"
              RowDefinitions="auto,auto,auto,auto,auto"
              Padding="20">
            <VerticalStackLayout Grid.Row="0">
                <Image 
                    Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                    HorizontalOptions="Start" 
                    VerticalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label 
                    Grid.Row="1"
                    Text="Forgot Password"
                    HorizontalTextAlignment="Center"
                    FontSize="20"
                    FontFamily="MartelSansExtraBold"
                    TextColor="#009933"/>
                <Label 
                    Grid.Row="2"
                    Text="Enter your email and request a password reset."
                    FontSize="12"
                    FontFamily="MartelSansRegular"
                    Margin="0,30,0,0"/>
                <Border 
                    Grid.Row="3"
                    Margin="10"
                    StrokeShape="RoundRectangle 30"
                    Stroke="#336699"
                    WidthRequest="350"
                    HeightRequest="45"
                    StrokeThickness="1"
                    BackgroundColor="#1A009933"
                    Padding="15,0">
                    <Entry
                        Placeholder="Enter your Email"
                        PlaceholderColor="#777777"
                        FontSize="12"
                        TextColor="{AppThemeBinding Dark=White, Light=Black}"
                        Keyboard="Email"
                        x:Name="EmailEntry"
                        TextChanged="OnEmailResetTextChanged"
                        FontFamily="MartelSansRegular"/>
                 </Border>
                    <!--Static button-->
                <Grid 
                    Grid.Row="4"
                    HeightRequest="230"
                    Padding="20,30,20,15"
                    RowDefinitions="Auto,Auto,Auto">
                    <Border 
                        Grid.Row="0"
                        Style="{StaticResource ButtonOne}"
                        Margin="0,50,0,20"
                        WidthRequest="330"
                        HeightRequest="50"
                        IsEnabled="False"
                        x:Name="VerificationCodeButton">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NavToEmailVerified"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label
                                x:Name="VerificationCodeTxt"
                                Text="Send Verification Code"
                                TextColor="{AppThemeBinding Dark=Black, Light=White}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                FontSize="12"
                                FontFamily="MartelSansBold"
                                FontAttributes="Bold"/>
                            <ActivityIndicator
                                x:Name="VerificationCodeIndicator"
                                Color="{AppThemeBinding Dark=Black, Light=White}"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center"
                                IsVisible="False"
                                IsRunning="False" />
                        </Grid>
                    </Border>
                    <Label 
                        Grid.Row="1"
                        HorizontalOptions="Center"
                        FontFamily="MartelSansRegular"
                        FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text=" Don't have an Ours Account "  TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                                <Span Text="Create Account"  TextColor="#009933" 
                                      FontAttributes="Bold">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="NavToCreateNewAccount"/>
                                    </Span.GestureRecognizers>
                                    </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
                <Image
                     Grid.Row="2"
                     Source="footer_disclaimer.png"
                     HorizontalOptions="Center"
                     VerticalOptions="End"/>
            </VerticalStackLayout>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"/>
    </Grid>
</ContentPage>