<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PreciousPractice.RegistrationCertificate"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}"
             Title="RegistrationCertificate">

    <Grid 
        RowDefinitions="*,auto">
        <Grid 
            Grid.Row="0">
            <ScrollView>
                <VerticalStackLayout 
                    Padding="20"
                    Spacing="15">
                    <!-- Vector icon -->
                    <Image Source="{AppThemeBinding Light=vector_left_black.png,
                                                    Dark=vector_left_white.png}"
                           HeightRequest="24"
                           WidthRequest="24"
                           HorizontalOptions="Start">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackIconTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <!-- Registration Certificate -->
                    <Label 
                        Text="Registration Certificate"
                        FontSize="20"
                        FontFamily="MartelSansExtraBold"
                        HorizontalOptions="Start" />

                    <!-- Certificate image -->
                    <Image
                        Source="certificate_registration.png"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        HeightRequest="372"/>
                    <Label
                        TextColor="{AppThemeBinding Light=Black, Dark=#393938}"
                        Text="This certificate is displayed for transparency and verification purposes only."
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        FontFamily="MartelSansRegular"
                        FontSize="12"
                        LineHeight="1.0"/>
                    <Border
                        Stroke="Transparent"
                         Padding="15">
                        <Border.Background>
                            <LinearGradientBrush
                                StartPoint ="0,0"
                                EndPoint="0,1">
                                <GradientStop
                                    Offset="0"
                                    Color="{AppThemeBinding Light=#F1F3F8, Dark=#1F2022}"/>
                                <GradientStop
                                        Offset="1"
                                        Color="{AppThemeBinding Light=#F1F3F8, Dark=#383B3F}"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout                       
                                 Spacing="10">
                            <HorizontalStackLayout
                                    Spacing="10">
                                <Image 
                                    Source="warning_icon.png"/>
                                <Label
                                    Text="ORGANIZATION DETAILS"
                                    FontAttributes="Bold"
                                    FontFamily="MartelSansBold"
                                    FontSize="14"/>
                            </HorizontalStackLayout>
                            <Label
                                FontSize="12"
                                 FontFamily="MartelSansRegular"
                                  HorizontalTextAlignment="Justify">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            Text="The display of this registration certificate is for transparency and trust-building purposes only."/>
                                        <Span
                                            Text="&#10;"/>
                                        <Span
                                            Text="This registration confirms the cooperative status of the organization under Lagos State law and does not constitute a banking or financial services license."/>
                                        <Span
                                            Text="&#10;"/>
                                        <Span
                                            Text="&#10;"/>
                                        <Span
                                            Text="The cooperative uses this mobile application solely to provide convenience for its members to make savings contributions and access cooperative facilities through the use of technology. The application is a digital channel for member service."/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <VerticalStackLayout
            Grid.Row="1">
            <Border             
                Style="{StaticResource ButtonOne}"
                Margin="0,10,0,10"
                WidthRequest="320">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer   Tapped="NavToLegalandCompliance"/>
                </Border.GestureRecognizers>
                <Label
                    Text="Done"
                    TextColor="{AppThemeBinding Light=White, Dark=Black}"
                    FontFamily="MartelSansBold"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                </Label>
            </Border>
            <Image
                 Source="footer_disclaimer.png"
                 HorizontalOptions="Center"
                 Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>