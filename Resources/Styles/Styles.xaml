    <ControlTemplate x:Key="RadioButtonOneTemplate">
        <Grid WidthRequest="22" HeightRequest="22">
            <Ellipse
            WidthRequest="22"
            HeightRequest="22"
            StrokeThickness="2"
            Stroke="{StaticResource Primary}">
                <Ellipse.Triggers>
                    <DataTrigger TargetType="Ellipse"
                             Binding="{Binding Source={RelativeSource TemplatedParent}, Path=IsChecked}"
                             Value="True">
                        <Setter Property="Fill" Value="{StaticResource Primary}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Ellipse"
                             Binding="{Binding Source={RelativeSource TemplatedParent}, Path=IsChecked}"
                             Value="False">
                        <Setter Property="Fill" Value="Transparent"/>
                    </DataTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse
            WidthRequest="12"
            HeightRequest="12"
            HorizontalOptions="Center"
            VerticalOptions="Center">
                <Ellipse.Triggers>
                    <DataTrigger TargetType="Ellipse"
                             Binding="{Binding Source={RelativeSource TemplatedParent}, Path=IsChecked}"
                             Value="True">
                        <Setter Property="Fill" Value="White"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Ellipse"
                             Binding="{Binding Source={RelativeSource TemplatedParent}, Path=IsChecked}"
                             Value="False">
                        <Setter Property="Fill" Value="Transparent"/>
                    </DataTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Label
            Text="&#10003;"
            FontSize="9"
            TextColor="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            IsVisible="False">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                             Binding="{Binding Source={RelativeSource TemplatedParent}, Path=IsChecked}"
                             Value="True">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                             Binding="{Binding Source={RelativeSource TemplatedParent}, Path=IsChecked}"
                             Value="False">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>
    </ControlTemplate>

