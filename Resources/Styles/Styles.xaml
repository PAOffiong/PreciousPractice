    <Style TargetType="Border" x:Key="ButtonOne">

        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 30" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Opacity" Value="1" />

        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#009933" Offset="0.0" />
                    <GradientStop Color="#336699" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger
            TargetType="Border"
            Binding="{Binding Source={RelativeSource Self}, Path=IsEnabled}"
            Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
   
