<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.SetPassword"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light= White, Dark=Black}"
             Title="SetPassword">
   
    <Grid 
        RowDefinitions="*,Auto">
        <Grid 
            Padding="20"
            RowDefinitions="Auto,Auto"   
            RowSpacing="10">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*">
                <Image Grid.Column="0"
                       Source= "{AppThemeBinding Light=vector_left_black.png,
                               Dark=vector_left_white.png}"
                        HeightRequest="18"
                        WidthRequest="18"
                        HorizontalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
            <Grid 
                Grid.Row="1"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <Label 
                    Grid.Row="0"
                    Margin="0,15,0,0"
                    Text="Set Your 6-Digits Login Password"
                    FontAttributes="Bold"
                    FontFamily="MartelSansExtraBold"
                    FontSize="18"/>
                
                <Label 
                    Grid.Row="1"
                    Text="The password must contain only numbers"
                    FontSize="12"
                    FontFamily="MartelSansRegular"
                    Margin="0,10"/>

                <Label 
                    Grid.Row="2"
                    Text="Set Password"
                    FontFamily="MartelSansSemiBold"
                    FontSize="12"
                    Margin="0,30,0,0"
                    FontAttributes="Bold"/>

                <Grid 
                    Grid.Row="3"
                    ColumnDefinitions="*,*,*,*,*,*"        
                    ColumnSpacing="6"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,10,0,0">
                    <Grid 
                        Grid.Column="0"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                           Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code1"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                    <Grid 
                        Grid.Column="1"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                            Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code2"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"      
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                    <Grid 
                        Grid.Column="2"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                            Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code3"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>

                    <Grid 
                        Grid.Column="3"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                            Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code4"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                    <Grid 
                        Grid.Column="4"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                            Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code5"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"   
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                    <Grid 
                        Grid.Column="5"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                            Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code6"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"   
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                </Grid>
                <Label 
                    Grid.Row="4"
                    Text=" Re-Enter Password"
                    FontFamily="MartelSansSemiBold"
                    FontSize="12"
                    Margin="0,60,0,0"
                    FontAttributes="Bold"/>
                <Grid 
                    Grid.Row="5"
                    ColumnDefinitions="*,*,*,*,*,*"        
                    ColumnSpacing="6"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,20,0,0">

                    <Grid 
                        Grid.Column="0"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                        <Image
                           Source="blue_ellipse.png"/>
                        <Entry 
                            x:Name="Code7"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"  
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                  </Grid>    
                  <Grid 
                      Grid.Column="1"
                      HeightRequest="50"
                      WidthRequest="50"
                      Padding="0">
                     <Image
                          Source="blue_ellipse.png"/>
                     <Entry  
                          x:Name="Code8"
                          Keyboard="Numeric"
                          MaxLength="1"
                          IsPassword="True"   
                          TextChanged="OnCodeTextChanged"
                          Focused="OnCodeFocused"
                          FontSize="20"
                          FontAttributes="Bold"
                          HorizontalTextAlignment="Center"
                          VerticalTextAlignment="Center"
                          TextColor="{AppThemeBinding Light=Black, Dark=White}"
                          BackgroundColor="Transparent"
                          Margin="0"/>
                    </Grid> 
                    <Grid 
                        Grid.Column="2"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                       <Image
                            Source="blue_ellipse.png"/>
                       <Entry 
                           x:Name="Code9"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"  
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>   
                        
                    <Grid 
                        Grid.Column="3"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                       <Image
                            Source="blue_ellipse.png"/>
                       <Entry 
                           x:Name="Code10"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"  
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                    <Grid 
                        Grid.Column="4"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                       <Image
                            Source="blue_ellipse.png"/>
                       <Entry 
                           x:Name="Code11"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"  
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                     </Grid>   
                    <Grid 
                        Grid.Column="5"
                        HeightRequest="50"
                        WidthRequest="50"
                        Padding="0">
                       <Image
                            Source="blue_ellipse.png"/>
                       <Entry 
                           x:Name="Code12"
                            Keyboard="Numeric"
                            MaxLength="1"
                            IsPassword="True"  
                            TextChanged="OnCodeTextChanged"
                            Focused="OnCodeFocused"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BackgroundColor="Transparent"
                            Margin="0"/>
                    </Grid>
                </Grid>                
            </Grid>
        </Grid>
        <VerticalStackLayout
           Grid.Row="1">
            <Border
                x:Name="showPasswordBorder"
                Style="{StaticResource ButtonOne}"
                Margin="0,0,0,50"
                WidthRequest="320"
                HeightRequest="45">
              <Border.GestureRecognizers>
                    <TapGestureRecognizer  Tapped="OnShowPasswordTapped"/>
              </Border.GestureRecognizers>
                <Grid>
                    <Label
                        x:Name="SetPasswordTxt"
                        Text="Next"
                        FontAttributes="Bold"
                        FontFamily="MartelSansSemiBold"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=White, Dark=Black}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                    <ActivityIndicator
                         x:Name="SetPasswordIndicator"
                         Color="{AppThemeBinding Light=White, Dark=Black}"
                         WidthRequest="18"
                         HeightRequest="18"
                         VerticalOptions="Center"
                         IsVisible="False"
                         IsRunning="False"/>
                </Grid>
            </Border>
            <Image
                Source="footer_disclaimer.png"
                HorizontalOptions="Center"
                Margin="0,20,0,0"/>
        </VerticalStackLayout>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>