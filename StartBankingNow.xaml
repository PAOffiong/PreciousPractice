<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.StartBankingNow"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
             Title="StartBankingNow">
    
    <Grid 
        RowDefinitions="*,Auto">
        <Grid 
            Grid.Row="0"
            Padding="20"
            RowSpacing="10"                         
            RowDefinitions="Auto,Auto,Auto,Auto">
            <Image 
                Grid.Row="0"
                Source="successful.png"
                HorizontalOptions="Center"
                WidthRequest="142"
                HeightRequest="142"
                Margin="0,60,0,0"/>
            <Label 
                Grid.Row="1"
                Text="Successful"
                HorizontalOptions="Center"
                FontAttributes="Bold"
                FontSize="32"
                FontFamily="MartelSansExtraBold"/>
            <Label 
                Grid.Row="2"
                Text="Congrats your account details are shown below"
                FontSize="12"
                FontFamily="MartelSansRegular"
                HorizontalOptions="Center"/>
            <Border
                Grid.Row="3"
                Stroke="{AppThemeBinding Light=Black, Dark=White}"
                StrokeThickness="1"
                BackgroundColor="#1A009933"
                StrokeShape="RoundRectangle 10"
                Margin="0,40,0,0"
                Padding="4,12">
                <VerticalStackLayout>
                    <Label
                        Text="Pyrowo Account Number"
                        HorizontalOptions="Center"
                        FontFamily="MartelSansRegular"
                        FontSize="12"/>
                    <Grid 
                        ColumnDefinitions="Auto,Auto"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text=""
                            x:Name="AccountNumberLabel"
                            FontSize="20"
                            FontAttributes="Bold"
                            FontFamily="MartelSansSemiBold"
                            VerticalOptions="Center"/>
                        <Image 
                            Grid.Column="1"
                            Source="copied_icon.png"
                            WidthRequest="12"
                            HeightRequest="15"
                            Margin="8,0,0,0"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyAccountNumberTapped"/>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                    <Grid 
                        ColumnDefinitions="Auto,*,Auto"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        Padding="15,0,5,0"
                        ColumnSpacing="5">
                        <HorizontalStackLayout 
                            Grid.Column="0">
                            <Image 
                               Source="coin_icon.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center"/>
                            <Label 
                              Text="Tier 1" 
                              FontFamily="MartelSansRegular"
                              FontSize="12"
                              VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Grid 
                            Grid.Column="2"
                            VerticalOptions="End">
                            <Image
                                Source="rectangle_ellipse.png"
                                WidthRequest="74"
                                HeightRequest="26"/>
                            <Label
                                Text="Upgrade"
                                FontFamily="MartelSansRegular"
                                FontSize="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Grid>
                    </Grid>
                    <Grid 
                        ColumnDefinitions="Auto,*,Auto"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        Padding="15,0,5,0"
                        ColumnSpacing="5"
                        Margin="0,10,0,0">
                        <Label 
                            Grid.Column="0"
                            TextColor="{AppThemeBinding Light=Black, Dark=#666666}"
                            Text="Daily Transaction Limit"
                            FontFamily="MartelSansRegular"
                            FontSize="12"
                            VerticalOptions="Start"/>
                        <Label 
                            Grid.Column="2"
                            Text="N50,000.00"
                            TextColor="#336699"/>
                    </Grid>
                    <Grid 
                        ColumnDefinitions="Auto,*,Auto"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        Padding="15,0,5,0"
                        ColumnSpacing="5"
                        Margin="0,10,0,0">
                        <Label
                            Grid.Column="0"
                            TextColor= "{AppThemeBinding Light=Black, Dark=#666666}"
                            Text="Maximum Account Balance"
                            FontFamily="MartelSansRegular"
                            FontSize="12"
                            VerticalOptions="Start"/>
                        <Label 
                            Grid.Column="2"
                            Text="N300,000.00"
                            TextColor="#336699"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        
        <Grid 
            Grid.Row="1"
            RowDefinitions="auto,auto">
            <Border
                Grid.Row="0"
                x:Name="StartBankingNowButton"
                Style="{StaticResource ButtonOne}"
                Margin="0,50,0,30"
                HeightRequest="45"
                IsEnabled="True">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NavToRegistrationPage"/>
                </Border.GestureRecognizers>
                <Grid>
                    <Label 
                        x:Name="startTxt"
                        Text="Start Banking Now"
                        FontFamily="MartelSansBold"
                        TextColor="{AppThemeBinding Light=White, Dark=Black}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                   <ActivityIndicator
                         x:Name="StartIndicator"
                         Color="{AppThemeBinding Light=White, Dark=Black}"
                         WidthRequest="18"
                         HeightRequest="18"
                         VerticalOptions="Center"
                         IsVisible="False"
                         IsRunning="False" />
                </Grid>    
            </Border>
            <Image
                 Grid.Row="1"
                 Source="footer_disclaimer.png"
                 HorizontalOptions="Center"
                 Margin="0,20,0,0"/>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>