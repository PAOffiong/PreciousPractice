<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.SuccessPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=Black, Light=White}"
             Title="SuccessPage">
    <Grid
        RowDefinitions="*,Auto">
        <Grid
            Grid.Row="0"
            Padding="20"
            RowSpacing="10"                         
            RowDefinitions="Auto,Auto,Auto">
              <Image 
                  Grid.Row="0"
                   Source="successful.png"
                   HorizontalOptions="Center"
                   WidthRequest="142"
                   HeightRequest="142"
                   Margin="0,60,0,0"/>
              <Label 
                  Grid.Row="1"
                   Text="Successful"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="32"
                   FontFamily="MartelSansExtraBold"/>
              <Label 
                  Grid.Row="2"
                  Text="Congrats your account has been registered on the &#10; Mobile Banking App."
                   LineHeight="1.3"
                   FontSize="12"
                   FontFamily="MartelSansRegular"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>
        </Grid>    
        <Grid 
            Grid.Row="1">
           <Border
                x:Name="StartBankingNowButton"
                Style="{StaticResource ButtonOne}"
                Margin="0,50,0,30"
                WidthRequest="320"
                IsEnabled="True">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer  Tapped="NavToRegisterDeviceLogin"/>
                </Border.GestureRecognizers>
                <Grid>
                    <Label 
                        x:Name="startTxt"
                        Text="Start Banking Now"
                        FontFamily="MartelSansBold"
                        TextColor="{AppThemeBinding Dark=Black, Light=White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                    <ActivityIndicator
                        x:Name="StartIndicator"
                        Color="{AppThemeBinding Dark=Black, Light=White}"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center"
                        IsVisible="False"
                        IsRunning="False" />
                    </Grid>
              </Border>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>