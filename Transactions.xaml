<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             Shell.NavBarIsVisible="False"
             x:Class="PreciousPractice.Transactions"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
             Title="Transactions">
    <Grid>
        <Grid RowDefinitions="Auto,*" >
            <!--header-->
            <Grid 
                Grid.Row="0"
                RowDefinitions="auto,auto"
                ColumnDefinitions="auto,*,auto"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EBF0F5}"
                Padding="20,20,20,20"
                RowSpacing="10">
                <Image 
                    x:Name="BackIcon"
                    Grid.Row="0"
                    Grid.Column="0"
                    Source= "{AppThemeBinding Light=vector_left_black.png,
                               Dark=vector_left_white.png}"
                    HorizontalOptions="Start" 
                    VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label 
                    Grid.Row="0"
                    Grid.Column="1"
                    TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                    Text="Transactions"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontFamily="MartelSansExtraBold"
                    FontSize="20"/>
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="Download"
                    TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                    FontSize="13"
                    FontFamily="MartelSansBold"
                    VerticalOptions="Center"
                    HorizontalOptions="End"/>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#141414}"
                    Stroke="#336699"                   
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 30"
                    HeightRequest="36">
                    <HorizontalStackLayout
                         VerticalOptions="Center">
                        <Image 
                            Margin="15,0,0,0"
                            Source="search_icon.png"
                            WidthRequest="15"
                            HeightRequest="15"
                            VerticalOptions="Center"/>
                        <Entry
                            Placeholder="Search"
                            VerticalOptions="Center"
                            HorizontalOptions="Start"
                            VerticalTextAlignment="Center"
                            FontFamily="MartelSansRegular"
                            FontSize="13"
                            Margin="10,5,0,0"
                            PlaceholderColor="#336699"/>
                    </HorizontalStackLayout>
                </Border>
                <Image
                    Grid.Row="1"
                    Grid.Column="2"
                    Source="{AppThemeBinding Light=on_click.png, Dark=black_on_click.png}"
                    VerticalOptions="Center"
                    HorizontalOptions="End">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavToTransactionFilter"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
            <!--transactions-->
            <Grid Grid.Row="1" Padding="20">
                <Border
                    BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#EBF0F5}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 15">
                    <ScrollView VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout IsVisible="False">
                            <Label
                                Text="Feb 2025"
                                FontFamily="MartelSansBold"
                                TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                                FontSize="16"
                                Margin="15"/>
                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                                HorizontalOptions="Fill"/>
                            
                            <VerticalStackLayout
                                x:Name="TransactionsStack">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid 
                                            ColumnDefinitions="auto,*,auto,auto">
                                            <Image 
                                                Grid.Column="0"
                                                Margin="15,0,0,0"
                                                Source="{Binding BankIcon}"
                                                HeightRequest="30"
                                                WidthRequest="30"
                                                HorizontalOptions="Start"/>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label 
                                                    Margin="5,5,0,0"
                                                    FontFamily="MartelSansRegular"
                                                    TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Preposition}" FontSize="12"/>
                                                            <Span Text="{Binding PersonName}" FontSize="14"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label 
                                                    Text="{Binding DateTimeText}"
                                                    TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                                                    Margin="5,0,0,0"
                                                    FontSize="7"
                                                    FontFamily="MartelSansSemiBold"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Margin="0,5,20,10">
                                                <Label 
                                                    Text="{Binding AmountText}"
                                                    FontFamily="MartelSansSemiBold"
                                                    TextColor="{Binding AmountTextColor}"/>
                                                <Grid Margin="0,0,0,5">
                                                    <Image Source="{Binding StatusIcon}"/>
                                                    <Label 
                                                        Text="{Binding StatusText}"
                                                        FontSize="7"
                                                        HorizontalOptions="Center"
                                                        TextColor="{Binding StatusColor}"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>
        <!--Popup-->
        <Grid
            IsVisible="True">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Image
                    Source="no_transaction_icon.png"
                    HorizontalOptions="Center"/>
                <Label
                    Text="Nothing to see yet!"
                    TextColor="#009933"
                    FontFamily="MartelSansBold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"/>
                <Label
                    HorizontalTextAlignment="Center"
                    FontFamily="MartelSansRegular"
                    FontSize="16">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Once you initiate any transaction, your"/>
                            <Span Text="&#10;"/>
                            <Span Text="recent transactions will appear here."/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Grid>
        <local:LoadingOverlay
            x:Name="Loading"/>
    </Grid>
</ContentPage>