<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PreciousPractice"
             x:Class="PreciousPractice.TransferSummary"
             BackgroundColor="{AppThemeBinding Dark=Black, Light=White}"
             Title="TransferSummary"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,auto"
          Padding="20">
        <Grid Grid.Row="0"
              RowDefinitions="auto,auto,auto,auto,auto"
              RowSpacing="15">
            <Grid 
                ColumnDefinitions="auto,*"
                Grid.Row="0">
                <Image 
                    Grid.Column="0"
                    Source="{AppThemeBinding Light=vector_left_black.png, Dark=vector_left_white.png}"
                    HorizontalOptions="Start" 
                    VerticalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackIconTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label
                    Grid.Column="1"
                    Text="Transfer Summary"
                    FontSize="20"
                    FontFamily="MartelSansBold"
                    HorizontalOptions="Center"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
            </Grid>
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,20,0,0">
                <Label
                    Text="Transfer from"
                    FontFamily="MartelSansRegular"
                    FontSize="12"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                <Border
                    BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#1A336699}"
                    Stroke="Transparent"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="5">
                    <VerticalStackLayout>
                        <Label
                            x:Name="AvailableBalance"
                            Margin="0,5,0,0"
                            Text=""
                            FontSize="20"
                            TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                            HorizontalOptions="Center"
                            FontFamily="MartelSansExtraBold"/>
                        <Grid
                            ColumnDefinitions="auto,*,auto"
                            Margin="20,0,20,0">
                            <HorizontalStackLayout
                                Grid.Column="0">
                                <Image
                                    Source="bank_transfer_icon.png"
                                    WidthRequest="13"
                                    HeightRequest="13"/>
                                <Label
                                    TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                                    x:Name="AccountNumberLabel"
                                    Margin="5,0,0,0"
                                    Text=""
                                    FontSize="14"
                                    FontFamily="MartelSansRegular"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout
                                Grid.Column="2">
                                <Image         
                                    Source="person_icon.png"
                                    WidthRequest="13"
                                    HeightRequest="13"/>
                                <Label
                                    TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                                    Margin="5,0,0,0"
                                    Text="Janet Doe Kehinde"
                                    FontSize="14"
                                    FontFamily="MartelSansRegular"/>
                            </HorizontalStackLayout>
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
            </VerticalStackLayout>
           
            <VerticalStackLayout
                Grid.Row="2"
                Margin="0,15,0,0">
                <Label
                     Text="Transfer to"
                     FontFamily="MartelSansRegular"
                     FontSize="12"
                     TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                <Border
                    BackgroundColor="{AppThemeBinding Dark=#171C21, Light=#1A336699}"
                    Stroke="Transparent"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="5">
                    <Grid 
                        ColumnDefinitions="auto,*,auto">
                        <Image
                            x:Name="BankIconImage"
                             Grid.Column="0"
                             Source="flower_green.png"
                             VerticalOptions="Center"
                             HorizontalOptions="Start"
                             WidthRequest="30"
                             HeightRequest="30"
                             Margin="15,0,0,0"/>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalOptions="Center">
                            <Label
                                 x:Name="DetailsAccountNameLabel"
                                 Text=""
                                 FontFamily="MartelSansBold"
                                 FontSize="14"
                                 TextColor="{AppThemeBinding Dark=#FFFFFF,Light=#141414}"/>
                            <Label
                                 x:Name="DetailsAccountNumberLabel"
                                 Text=""
                                 FontFamily="MartelSansBold"
                                 FontSize="12"
                                 TextColor="{AppThemeBinding Dark=#FFFFFF,Light=#141414}"/>
                        </VerticalStackLayout>
                        <Label
                             Grid.Column="2"
                             Text="Change"
                             TextColor="{AppThemeBinding Dark=#FFFFFF,Light=#141414}"
                             FontFamily="MartelSansBold"
                             FontSize="12"
                             VerticalOptions="Center"
                             Margin="0,0,10,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangeTapped"/>
                            </Label.GestureRecognizers>
                            </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>
            
            <VerticalStackLayout
                Grid.Row="3">
                <Label
                    Text="Amount to send"
                    FontFamily="MartelSansRegular"
                    FontSize="12"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"/>
                <Border
                    Stroke="#336699"
                    StrokeShape="RoundRectangle 30"
                    HeightRequest="40">
                    <HorizontalStackLayout>
                        <Image 
                            Source="gray_banktransfer.png"
                            HeightRequest="18"
                            WidthRequest="16"
                            Margin="25,0,10,0"/>
                        <Entry
                            TextColor="{AppThemeBinding Light=#141414, Dark=#FFFFFF}"
                            Keyboard="Numeric"
                            Placeholder="0.0"
                            PlaceholderColor="#878787"
                            x:Name="AmountEntry"
                            TextChanged="OnAmountEntryTextChanged"/>
                    </HorizontalStackLayout>
                </Border>
                <ScrollView 
                    Orientation="Horizontal"
                    Margin="0,15,0,0"
                    HorizontalScrollBarVisibility="Never">
                    <Grid 
                        ColumnDefinitions="auto,auto,auto,auto,auto,auto"
                        ColumnSpacing="5">
                        <Border
                            x:Name="FiveHundred"
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            Background="#009933">
                            <Label        
                                Padding="10,6"
                                TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                Text="N500.00"
                                FontSize="12"
                                FontFamily="MartelSansRegular"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAmountTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="OneThousand"
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            Background="#009933">
                            <Label                              
                                Padding="10,6"
                                TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                Text="N1,000.00"
                                FontSize="12"
                                FontFamily="MartelSansRegular"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAmountTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="TwoThousand"
                            Grid.Column="2"
                            StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            Background="#009933">
                            <Label                               
                                Padding="10,6"
                                TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                Text="N2,000.00"
                                FontSize="12"
                                FontFamily="MartelSansRegular"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAmountTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="FiveThousand"
                            Grid.Column="3"
                            StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            Background="#009933">
                            <Label                             
                                Padding="10,6"
                                TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                Text="N5,000.00"
                                FontSize="12"
                                FontFamily="MartelSansRegular"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAmountTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="TenThousand"
                            Grid.Column="4"
                            StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            Background="#009933">
                            <Label                             
                                Padding="10,6"
                                TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                Text="N10,000.00"
                                FontSize="12"
                                FontFamily="MartelSansRegular"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAmountTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="FifteenThousand"
                            Grid.Column="5"
                            StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            Background="#009933">
                            <Label                             
                                Padding="10,6"
                                TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                                Text="N15,000.00"
                                FontSize="12"
                                FontFamily="MartelSansRegular"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAmountTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </ScrollView>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="4"
                Margin="0,10,0,0">
                <Label
                    Text="Remark(Optional)"
                    FontFamily="MartelSansRegular"
                    FontSize="10"
                    Margin="0,10,0,0"/>
                <Border
                    Stroke="#336699"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="2">
                    <Entry
                        x:Name="RemarkEntry"
                        Placeholder="what's the expense for? (Optional)"
                        PlaceholderColor="#878787"
                        Keyboard="Text"
                        TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#141414}"
                        FontSize="14"
                        Margin="10,0,0,0"
                        FontFamily="MartelSansRegular"/>
                </Border>
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="20"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0">
                    <Border
                        x:Name="Purchase"
                        Grid.Column="0"
                        BackgroundColor="#009933"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 30"
                        Padding="6,6">
                        <Label
                            Text="Purchase"
                            TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                            FontSize="14"
                            FontFamily="MartelSansRegular"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRemarkTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border
                        x:Name="Personal"
                        Grid.Column="1"
                        BackgroundColor="#009933"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 30"
                        Padding="6,6">
                        <Label
                            Text="Personal"
                            TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                            FontSize="14"
                            FontFamily="MartelSansRegular"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRemarkTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border
                        x:Name="Savings"
                        Grid.Column="2"
                        BackgroundColor="#009933"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 30"
                        Padding="6,6">
                        <Label
                            Text="Savings"
                            TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                            FontSize="14"
                            FontFamily="MartelSansRegular"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRemarkTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
        <Border
            x:Name="ProceedBorder"
            Grid.Row="1"  IsEnabled="False"
            Style="{StaticResource ButtonOne}"
            HeightRequest="50"
            WidthRequest="330">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="NavToTransferSummaryPage"/>
            </Border.GestureRecognizers>
            <Grid>
                <Label
                    x:Name="ProceedTxt"
                    Text="Confirm"
                    FontSize="14"
                    FontFamily="MartelSansBold"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    TextColor="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"/>
                <ActivityIndicator
                    x:Name="ProceedIndicator"
                    VerticalOptions="Center"
                    HeightRequest="18"
                    WidthRequest="18"
                    Color="{AppThemeBinding Dark=#141414, Light=#FFFFFF}"
                    IsRunning="False"
                    IsVisible="False"/>
            </Grid>
        </Border>
        <local:LoadingOverlay
            x:Name="Loading"
            Grid.RowSpan="2"/>
    </Grid>
</ContentPage>